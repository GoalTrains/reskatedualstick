@@ -0,0 +1,111 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include "../gamepad_navigation.h"
+#include "../menu_navigation.h"
+#include <cassert>
+#include <iostream>
+
+static int first_clicks{}, second_clicks{};
+static ImGuiWindow* sidebar{}, *content{}, *nested{};
+static bool enter_nested{}, open_options{}, focus_sidebar{};
+static void menu_frame() {
+    using namespace dingosdk::overlay::menu;
+    claim_menu_back(true);
+    ImGui::NewFrame();
+    ImGui::Begin("Back navigation");
+    menu_back(sidebar, content);
+    ImGui::BeginChild("Sidebar", ImVec2(180, 400));
+    sidebar = ImGui::GetCurrentWindow();
+    if (focus_sidebar) { focus_menu_panel(sidebar,true); focus_sidebar = false; }
+    const bool enter = ImGui::InvisibleButton("Page", ImVec2(160,40), ImGuiButtonFlags_EnableNav);
+    ImGui::SetItemDefaultFocus();
+    ImGui::EndChild(); ImGui::SameLine();
+    ImGui::BeginChild("Content", ImVec2(400,400));
+    content = ImGui::GetCurrentWindow();
+    if (enter) focus_menu_panel(content,true);
+    ImGui::Button("Page tab");
+    ImGui::BeginChild("Nested options", ImVec2(300,200));
+    nested = ImGui::GetCurrentWindow();
+    if (enter_nested) { focus_menu_panel(nested,true); enter_nested = false; }
+    ImGui::Button("Setting");
+    if (open_options) { ImGui::OpenPopup("Options"); open_options = false; }
+    if (ImGui::BeginPopup("Options")) { ImGui::Button("Popup option"); ImGui::EndPopup(); }
+    ImGui::EndChild(); ImGui::EndChild(); ImGui::End(); ImGui::Render();
+}
+static void frame() {
+    ImGui::NewFrame();
+    ImGui::Begin("Controller navigation");
+    // The Insert sidebar, category tabs and option tiles are custom-drawn
+    // InvisibleButtons. Their default flags exclude navigation entirely.
+    if (ImGui::InvisibleButton("First", ImVec2(160,40), ImGuiButtonFlags_EnableNav)) ++first_clicks;
+    ImGui::SetItemDefaultFocus();
+    if (ImGui::InvisibleButton("Second", ImVec2(160,40), ImGuiButtonFlags_EnableNav)) ++second_clicks;
+    ImGui::End(); ImGui::Render();
+}
+int main() {
+    ImGui::CreateContext();
+    auto& io = ImGui::GetIO();
+    io.ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+    io.ConfigInputTrickleEventQueue = false;
+    io.DisplaySize = ImVec2(1000,1000); io.DeltaTime = 1.f/60;
+    io.IniFilename = nullptr;
+    unsigned char* pixels{}; int width{},height{};
+    io.Fonts->GetTexDataAsRGBA32(&pixels,&width,&height);
+    using dingosdk::overlay::detail::feed_gamepad_navigation;
+    feed_gamepad_navigation(io,true,0x1002,0,0,0,0); frame();
+    assert(io.BackendFlags & ImGuiBackendFlags_HasGamepad);
+    assert(ImGui::IsKeyDown(ImGuiKey_GamepadFaceDown));
+    assert(ImGui::IsKeyDown(ImGuiKey_GamepadDpadDown));
+    feed_gamepad_navigation(io,true,0,32767,-32768,255,0); frame();
+    assert(!ImGui::IsKeyDown(ImGuiKey_GamepadFaceDown));
+    assert(ImGui::IsKeyDown(ImGuiKey_GamepadLStickRight));
+    assert(ImGui::IsKeyDown(ImGuiKey_GamepadLStickDown));
+    assert(ImGui::IsKeyDown(ImGuiKey_GamepadL2));
+    feed_gamepad_navigation(io,true,0,4000,-4000,20,20); frame();
+    assert(!ImGui::IsKeyDown(ImGuiKey_GamepadLStickRight));
+    assert(!ImGui::IsKeyDown(ImGuiKey_GamepadLStickDown));
+    assert(!ImGui::IsKeyDown(ImGuiKey_GamepadL2));
+    feed_gamepad_navigation(io,true,0x2000,-32768,32767,0,255); frame();
+    assert(ImGui::IsKeyDown(ImGuiKey_GamepadFaceRight));
+    assert(ImGui::IsKeyDown(ImGuiKey_GamepadLStickLeft));
+    feed_gamepad_navigation(io,false,0xffff,-32768,32767,255,255); frame();
+    assert(!(io.BackendFlags & ImGuiBackendFlags_HasGamepad));
+    assert(!ImGui::IsKeyDown(ImGuiKey_GamepadFaceRight));
+    assert(!ImGui::IsKeyDown(ImGuiKey_GamepadLStickLeft));
+    assert(!ImGui::IsKeyDown(ImGuiKey_GamepadR2));
+    first_clicks = second_clicks = 0;
+    ImGui::SetWindowFocus("Controller navigation");
+    for (int i=0;i<3;++i) { feed_gamepad_navigation(io,true,0,0,0,0,0); frame(); }
+    feed_gamepad_navigation(io,true,0x0002,0,0,0,0); frame();
+    for (int i=0;i<2;++i) { feed_gamepad_navigation(io,true,0,0,0,0,0); frame(); }
+    feed_gamepad_navigation(io,true,0x1000,0,0,0,0); frame();
+    feed_gamepad_navigation(io,true,0,0,0,0,0); frame();
+    assert(first_clicks == 0 && second_clicks == 1);
+    ImGui::SetWindowFocus(nullptr);
+    for (int i=0;i<3;++i) { feed_gamepad_navigation(io,true,0,0,0,0,0); menu_frame(); }
+    focus_sidebar = true;
+    menu_frame(); menu_frame();
+    assert(ImGui::GetCurrentContext()->NavWindow == sidebar);
+    feed_gamepad_navigation(io,true,0x1000,0,0,0,0); menu_frame();
+    feed_gamepad_navigation(io,true,0,0,0,0,0); menu_frame();
+    assert(ImGui::GetCurrentContext()->NavWindow == content);
+    enter_nested = true; menu_frame(); menu_frame();
+    assert(ImGui::GetCurrentContext()->NavWindow == nested);
+    open_options = true; menu_frame(); menu_frame();
+    assert(!ImGui::GetCurrentContext()->OpenPopupStack.empty());
+    feed_gamepad_navigation(io,true,0x2000,0,0,0,0); menu_frame();
+    assert(ImGui::GetCurrentContext()->OpenPopupStack.empty());
+    assert(ImGui::GetCurrentContext()->NavWindow == nested);
+    feed_gamepad_navigation(io,true,0,0,0,0,0); menu_frame();
+    feed_gamepad_navigation(io,true,0x2000,0,0,0,0); menu_frame();
+    assert(ImGui::GetCurrentContext()->NavWindow == content);
+    feed_gamepad_navigation(io,true,0,0,0,0,0); menu_frame();
+    feed_gamepad_navigation(io,true,0x2000,0,0,0,0); menu_frame();
+    assert(ImGui::GetCurrentContext()->NavWindow == sidebar);
+    feed_gamepad_navigation(io,true,0,0,0,0,0); menu_frame();
+    feed_gamepad_navigation(io,true,0x2000,0,0,0,0); menu_frame();
+    assert(ImGui::GetCurrentContext()->NavWindow == sidebar);
+    ImGui::DestroyContext();
+    std::cout << "Controller navigation: buttons, analog, deadzones, ownership release and D-pad/A widget interaction passed\n";
+}
diff --git a/Extension/UI/Overlay/dual_stick_settings.h b/Extension/UI/Overlay/dual_stick_settings.h
new file mode 100644
index 0000000..9e09986
--- /dev/null
+++ b/Extension/UI/Overlay/dual_stick_settings.h
@@ -0,0 +1,129 @@
+#pragma once
+#include <Windows.h>
+#include <array>
+#include <map>
+#include <string>
+#include <cwchar>
+#include <utility>
+
+// Optional companion mod settings. Never install hooks or create a configuration
+// when the mod is absent. Resolve beside Skate.exe, independently of working dir.
+namespace dingosdk::dual_stick {
+inline constexpr wchar_t section[] = L"SessionControls";
+struct Choice {
+    const wchar_t* key;
+    const char* label;
+    int fallback;
+    std::array<int, 4> values;
+    std::array<const char*, 4> labels;
+    int count;
+};
+inline constexpr std::array choices{
+    Choice{L"FrontBackFoot", "Foot layout", 0, {0,1}, {"Left / right foot","Front / back foot"},2},
+    Choice{L"SwitchStance", "Switch behavior", 1, {0,1,3,2}, {"Off","On","True Foot","On + mirror"},4},
+    Choice{L"PopOnRelease", "Pop style", 0, {0,1}, {"Flick","Release"},2},
+    Choice{L"OneFootFlips", "One-stick flips", 0, {0,1}, {"Blocked","Allowed"},2},
+    Choice{L"StickSteering", "Stick steering", 0, {0,1}, {"Off","On"},2},
+    Choice{L"RevertInput", "Reverts", 2, {0,1,2}, {"Off","Double tap","Both triggers"},3},
+    Choice{L"SpinWindUp", "Spin wind-up", 1, {0,1}, {"Off","On"},2},
+    Choice{L"BodyFlips", "Body flips", 1, {0,1}, {"Off","On"},2},
+    Choice{L"AirControls", "Air controls", 1, {0,1}, {"Off","On"},2},
+    Choice{L"Powerslides", "Powerslides", 1, {0,1}, {"Off","On"},2},
+    Choice{L"GrindBumpMs", "Grind bump", 250, {0,250}, {"Off","On"},2}
+};
+struct KeyLess {
+    bool operator()(const std::wstring& a, const std::wstring& b) const { return _wcsicmp(a.c_str(), b.c_str()) < 0; }
+};
+using Section = std::map<std::wstring, std::wstring, KeyLess>;
+class Settings {
+    std::wstring path_;
+public:
+    explicit Settings(std::wstring path) : path_(std::move(path)) {}
+    static std::wstring game_path() {
+        std::array<wchar_t, 32768> buffer{};
+        const DWORD n = GetModuleFileNameW(nullptr, buffer.data(), static_cast<DWORD>(buffer.size()));
+        if (!n || n >= buffer.size()) return {};
+        std::wstring path(buffer.data(), n);
+        const auto slash = path.find_last_of(L"\\/");
+        if (slash == std::wstring::npos) return {};
+        return path.substr(0, slash + 1) + L"session_controls.ini";
+    }
+    bool available() const {
+        if (path_.empty()) return false;
+        const DWORD a = GetFileAttributesW(path_.c_str());
+        return a != INVALID_FILE_ATTRIBUTES && !(a & FILE_ATTRIBUTE_DIRECTORY);
+    }
+    int number(const wchar_t* key, int fallback, const wchar_t* from = section) const {
+        return static_cast<int>(GetPrivateProfileIntW(from, key, fallback, path_.c_str()));
+    }
+    std::wstring text(const wchar_t* key, const wchar_t* fallback, const wchar_t* from = section) const {
+        std::array<wchar_t, 256> buffer{};
+        GetPrivateProfileStringW(from, key, fallback, buffer.data(), static_cast<DWORD>(buffer.size()), path_.c_str());
+        return buffer.data();
+    }
+    bool read(Section& entries, const wchar_t* from = section) const {
+        std::array<wchar_t, 32768> buffer{};
+        const DWORD n = GetPrivateProfileSectionW(from, buffer.data(), static_cast<DWORD>(buffer.size()), path_.c_str());
+        if (n >= buffer.size() - 2) return false;
+        entries.clear();
+        for (const wchar_t* p = buffer.data(); *p; p += std::wcslen(p) + 1) {
+            const wchar_t* eq = std::wcschr(p, L'=');
+            if (eq) entries.emplace(std::wstring(p, eq), eq + 1);
+        }
+        return true;
+    }
+    bool write(const Section& entries, const wchar_t* to = section) const {
+        if (!available()) return false;
+        std::wstring buffer;
+        for (const auto& [key, value] : entries) {
+            buffer += key + L"=" + value;
+            buffer.push_back(L'\0');
+        }
+        buffer.push_back(L'\0');
+        if (entries.empty()) buffer.push_back(L'\0');
+        if (buffer.size() >= 32766) return false;
+        return WritePrivateProfileSectionW(to, buffer.c_str(), path_.c_str()) != FALSE;
+    }
+    bool set(const wchar_t* key, int value) const {
+        return available() && WritePrivateProfileStringW(section, key, std::to_wstring(value).c_str(), path_.c_str());
+    }
+    bool preset(bool xl) const {
+        Section entries;
+        if (!available() || !read(entries)) return false;
+        entries[L"FrontBackFoot"] = xl ? L"0" : L"1";
+        entries[L"SwitchStance"] = xl ? L"3" : L"1";
+        for (const auto* key : {L"PopOnRelease", L"StickSteering", L"OneFootFlips"}) entries[key] = xl ? L"1" : L"0";
+        entries[L"SwitchSource"] = L"4";
+        return write(entries);
+    }
+    bool active(bool xl) const {
+        const int flag = xl ? 1 : 0;
+        return number(L"FrontBackFoot",0) == (xl ? 0 : 1) && number(L"SwitchStance",1) == (xl ? 3 : 1) &&
+            number(L"PopOnRelease",0) == flag && number(L"StickSteering",0) == flag && number(L"OneFootFlips",0) == flag &&
+            number(L"SwitchSource",4) == 4;
+    }
+    static std::wstring slot_name(int slot) { return L"CustomPreset" + std::to_wstring(slot); }
+    bool filled(int slot) const { return slot >= 1 && slot <= 5 && number(L"PresetSaved",0,slot_name(slot).c_str()) == 1; }
+    bool save(int slot) const {
+        Section entries;
+        if (slot < 1 || slot > 5 || !available() || !read(entries)) return false;
+        for (const auto& c : choices) entries[c.key] = std::to_wstring(number(c.key,c.fallback));
+        for (const auto* key : {L"AutoStance",L"StockGrabAir",L"StockTransitionGround"})
+            entries[key] = std::to_wstring(number(key, std::wcscmp(key,L"AutoStance") == 0 ? 1 : 0));
+        entries[L"Stance"] = text(L"Stance",L"regular");
+        entries[L"SwitchSource"] = std::to_wstring(number(L"SwitchSource",4));
+        entries[L"PresetSaved"] = L"1";
+        return write(entries,slot_name(slot).c_str());
+    }
+    bool load(int slot) const {
+        Section current, saved;
+        if (!available() || !filled(slot) || !read(current) || !read(saved,slot_name(slot).c_str())) return false;
+        // Gameplay only: menu, recording and launch preferences remain global.
+        // Merge the supported keys so unrelated tuning and unknown future keys survive.
+        for (const auto& c : choices) if (saved.contains(c.key)) current[c.key] = saved[c.key];
+        for (const auto* key : {L"AutoStance",L"Stance",L"SwitchSource",L"StockGrabAir",L"StockTransitionGround"})
+            if (saved.contains(key)) current[key] = saved[key];
+        return write(current);
+    }
+};
+} // namespace dingosdk::dual_stick
diff --git a/Extension/UI/Overlay/gamepad_navigation.h b/Extension/UI/Overlay/gamepad_navigation.h
new file mode 100644
index 0000000..091fdb8
--- /dev/null
+++ b/Extension/UI/Overlay/gamepad_navigation.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <imgui.h>
+#include <algorithm>
+#include <cstdint>
+
+namespace dingosdk::overlay::detail {
+// Feed the existing raw multi-device reader rather than ImGui's slot-zero
+// XInput backend. That backend is disabled; it would also miss native HID pads.
+inline void feed_gamepad_navigation(ImGuiIO& io, bool available, std::uint16_t buttons,
+                                    short lx, short ly, unsigned char lt, unsigned char rt) {
+    if (available) io.BackendFlags |= ImGuiBackendFlags_HasGamepad;
+    else io.BackendFlags &= ~ImGuiBackendFlags_HasGamepad;
+    const auto digital = [&](ImGuiKey key, unsigned mask) { io.AddKeyEvent(key,available && (buttons & mask) != 0); };
+    digital(ImGuiKey_GamepadStart,0x0010); digital(ImGuiKey_GamepadBack,0x0020);
+    digital(ImGuiKey_GamepadFaceDown,0x1000); digital(ImGuiKey_GamepadFaceRight,0x2000);
+    digital(ImGuiKey_GamepadFaceLeft,0x4000); digital(ImGuiKey_GamepadFaceUp,0x8000);
+    digital(ImGuiKey_GamepadDpadUp,0x0001); digital(ImGuiKey_GamepadDpadDown,0x0002);
+    digital(ImGuiKey_GamepadDpadLeft,0x0004); digital(ImGuiKey_GamepadDpadRight,0x0008);
+    digital(ImGuiKey_GamepadL1,0x0100); digital(ImGuiKey_GamepadR1,0x0200);
+    digital(ImGuiKey_GamepadL3,0x0040); digital(ImGuiKey_GamepadR3,0x0080);
+    const auto analog = [&](ImGuiKey key, float value, float low, float high) {
+        const float amount = available ? std::clamp((value-low)/(high-low),0.f,1.f) : 0.f;
+        io.AddKeyAnalogEvent(key,amount > .1f,amount);
+    };
+    analog(ImGuiKey_GamepadL2,lt,30,255); analog(ImGuiKey_GamepadR2,rt,30,255);
+    analog(ImGuiKey_GamepadLStickLeft,-static_cast<float>(lx),7849,32767);
+    analog(ImGuiKey_GamepadLStickRight,lx,7849,32767);
+    analog(ImGuiKey_GamepadLStickUp,ly,7849,32767);
+    analog(ImGuiKey_GamepadLStickDown,-static_cast<float>(ly),7849,32767);
+}
+} // namespace dingosdk::overlay::detail
diff --git a/Extension/UI/Overlay/menu_navigation.h b/Extension/UI/Overlay/menu_navigation.h
new file mode 100644
index 0000000..cdfe139
--- /dev/null
+++ b/Extension/UI/Overlay/menu_navigation.h
@@ -0,0 +1,44 @@
+#pragma once
+#include <imgui_internal.h>
+
+namespace dingosdk::overlay::menu {
+// Own cancel before NewFrame so ImGui cannot cancel a child/popup and then
+// let the menu interpret the same press as another Back action.
+inline void claim_menu_back(bool enabled) {
+    if (enabled) ImGui::SetKeyOwner(ImGuiKey_GamepadFaceRight, ImHashStr("ReSkate menu back"));
+}
+inline void focus_menu_panel(ImGuiWindow* window, bool initialize = false) {
+    if (!window) return;
+    ImGui::FocusWindow(window);
+    ImGui::NavInitWindow(window, initialize);
+    ImGui::SetNavCursorVisibleAfterMove();
+}
+inline void menu_back(ImGuiWindow* sidebar, ImGuiWindow* content) {
+    auto& g = *ImGui::GetCurrentContext();
+    if (!ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight, false)) return;
+    if (g.ActiveId) { ImGui::ClearActiveID(); return; }
+    if (!g.OpenPopupStack.empty()) {
+        const auto* popup = g.OpenPopupStack.back().Window;
+        if (popup && !(popup->Flags & ImGuiWindowFlags_Modal))
+            ImGui::ClosePopupToLevel(g.OpenPopupStack.Size - 1, true);
+        return;
+    }
+    auto* window = g.NavWindow;
+    if (window && content && window != content) {
+        for (auto* parent = window->ParentWindow; parent; parent = parent->ParentWindow) {
+            if (parent == content) {
+                // Back out of one nested panel to its parent/tab controls.
+                auto* target = window->ParentWindow;
+                ImGui::FocusWindow(target);
+                ImGui::SetNavID(window->ChildId, ImGuiNavLayer_Main, target->NavRootFocusScopeId,
+                               ImGui::WindowRectAbsToRel(target, window->Rect()));
+                ImGui::SetNavCursorVisibleAfterMove();
+                return;
+            }
+        }
+    }
+    // The right-hand page is the outermost panel. Back returns to its sidebar
+    // selection; another Back there leaves the menu open.
+    focus_menu_panel(sidebar);
+}
+} // namespace dingosdk::overlay::menu
